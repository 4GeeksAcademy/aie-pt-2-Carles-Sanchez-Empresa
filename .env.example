# ─────────────────────────────────────────────────────────────
# TrackFlow — Variables de entorno (ejemplo)
# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env y completa los valores reales.
# ⚠️ .env está en .gitignore — no se versiona nunca.
#
# Variables del backend (services/api/):
#   - Se cargan automáticamente desde este .env (python-dotenv)
#   - PYTHONPATH se usa en el Docker para importar módulos
#
# Variables del frontend (uis/):
#   - NEXT_PUBLIC_API_HOST y NEXT_PUBLIC_API_PORT se usan en
#     next.config.ts para las rewrites por nombre de servicio Docker
#
# Docker Compose levanta: docker compose up --build
# ─────────────────────────────────────────────────────────────

# ─── JWT ────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=60

# ─── Supabase (Inventario PostgreSQL/SQLModel) ─────────────
SUPABASE_URL=postgresql://user:password@host:5432/trackflow

# ─── Resend (Email transaccional) ──────────────────────────
RESEND_API_TOKEN=
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:3001

# ─── Frontend (variables pasadas por docker-compose) ───────
NEXT_PUBLIC_API_HOST=api
NEXT_PUBLIC_API_PORT=8000
NEXT_PUBLIC_API_URL=http://api:8000
FRONTEND_URL=http://localhost:3000

# ─── Telemetry variables ───────
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
TELEMETRY_ENDPOINT=/telemetry/events

# ─── Qdrant & LLM / RAG (4Geeks) ───────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=trackflow_knowledge

LLM_BASE_URL=https://llm.4geeks.ai/v1
LLM_API_URL=https://llm.4geeks.ai
LLM_API_KEY=---
OPENAI_BASE_URL=https://llm.4geeks.ai/v1
OPENAI_API_KEY=---

# Modelo de Embeddings (separado, 1024 dimensiones)
EMBEDDING_MODEL=madrid-spain/openrouter/perplexity/pplx-embed-v1-0.6b
LLM_EMBEDDING_MODEL=madrid-spain/openrouter/perplexity/pplx-embed-v1-0.6b
EMBEDDING_VECTOR_SIZE=1024

# Modelo de Generación (separado del de embeddings)
GENERATION_MODEL=madrid-spain/openrouter/deepseek/deepseek-v4-flash
LLM_GENERATION_MODEL=madrid-spain/openrouter/deepseek/deepseek-v4-flash