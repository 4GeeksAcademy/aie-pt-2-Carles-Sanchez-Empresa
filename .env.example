# =============================================================
# TrackFlow — Variables de entorno (ejemplo)
# =============================================================
# Copia este archivo como .env y ajusta los valores reales.
# Todas las variables se cargan desde este mismo archivo.
#
# La API (services/api/) referencia automáticamente este .env
# de la raíz, no necesita su propio .env.

NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_INVENTORY_API_URL="http://127.0.0.1:8000"
ACCESS_TOKEN_EXPIRE_MINUTES=30
SECRET_KEY=...
RESEND_API_TOKEN="..."
RESEND_API_TOKEN_EXPIRATION=60
RESEND_FROM_EMAIL=...
FRONTEND_URL=http://localhost:3000
RESET_TOKEN_EXPIRE_MINUTES=60
SUPABASE_URL="postgresql://user:password@host:port/database"
