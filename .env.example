# ─────────────────────────────────────────────────────────────
# TrackFlow — Variables de entorno (ejemplo)
# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env y completa los valores reales.
# ⚠️ .env está en .gitignore — no se versiona nunca.
#
# Variables del backend (services/api/):
#   - Se cargan automáticamente desde este .env (python-dotenv)
#   - PYTHONPATH se usa en el Docker para importar módulos
#
# Variables del frontend (uis/):
#   - NEXT_PUBLIC_API_HOST y NEXT_PUBLIC_API_PORT se usan en
#     next.config.ts para las rewrites por nombre de servicio Docker
#
# Docker Compose levanta: docker compose up --build
# ─────────────────────────────────────────────────────────────

# ─── JWT ────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=60

# ─── Supabase (Inventario PostgreSQL/SQLModel) ─────────────
SUPABASE_URL=postgresql://user:password@host:5432/trackflow

# ─── Resend (Email transaccional) ──────────────────────────
RESEND_API_TOKEN=
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:3001

# ─── Frontend (variables pasadas por docker-compose) ───────
NEXT_PUBLIC_API_HOST=api
NEXT_PUBLIC_API_PORT=8000
