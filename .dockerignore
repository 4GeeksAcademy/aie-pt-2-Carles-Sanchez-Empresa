# ─────────────────────────────────────────────────────────────
# .dockerignore — Raíz del monorepo
# Excluye archivos innecesarios para el build Docker.
# Cada servicio construye desde context: . con su propio
# Dockerfile (services/Dockerfile, uis/Dockerfile).
# ─────────────────────────────────────────────────────────────

# Dependencias
node_modules/
**/node_modules/
**/.venv/
**/venv/

# Build / caché
.next/
**/.next/
**/dist/
**/coverage/
**/.turbo/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
**/*.egg-info/
build/
**/build/
dist/

# Entorno
.env*
venv/
.venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
*.sqlite
*.sqlite3
*.sqlite-*
*.db

# Datos locales de runtime: en Compose se montan desde volúmenes/rutas del host.
data/qdrant/
data/flower/
data/support_agent/
data/raw/
data/*checkpoint*.sqlite*

# Control de versiones
.git/

# Logs
*.log

# Test
tests/
.pytest_cache/

# Documentación
README*
AGENTS*
CONTEXT*
TESTING*
CLAUDE*
LICENSE*
company-choice*.md